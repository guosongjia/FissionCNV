# Snakemake state
.snakemake/

# Conda environments (managed by snakemake --conda-prefix conda_envs)
conda_envs/

# Pipeline outputs
cleaned/
mapped/
temp/
res/
logs/
benchmarks/

# Per-run inputs (point at real sequencing data, one table per species).
# config.yaml and samples.tsv stay tracked as templates but their local
# run-state edits are hidden via `git update-index --skip-worktree`.
samples.*.tsv

# Loose run artifacts
snakemake_run.log
nohup.out
*.log

# Editor / OS junk
.ipynb_checkpoints/
__pycache__/
*.pyc
.Rhistory
.DS_Store
.claude/

# Legacy CNVPipe ignores (kept for safety)
data/
analysis/
analysis2/
refs/
src/
bin/
tools/
bundle/
dust/
resources/GATK/
resources/SVM/
resources/ML/
resources/ML2/
